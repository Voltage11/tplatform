# ==========================================
# Общие системные файлы (OS / IDES)
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# Go
# ==========================================
# Компилированные бинарники и исполняемые файлы
backend/bin/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/backend  # если бинарник называется как папка

# Файлы архитектуры и тестов
backend/*.test
backend/*.out
backend/vendor/

# ==========================================
# Vue / Node.js
# ==========================================
# Зависимости
frontend/node_modules/
frontend/jspm_packages/

# Директории сборки (дистрибутив)
frontend/dist/
frontend/local

# Логи npm/yarn/pnpm
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Кэш инструментов сборки
frontend/.nuxt
frontend/.next
frontend/.vuepress/dist
frontend/.cache/

# ==========================================
# Секреты и конфигурация (ВАЖНО)
# ==========================================
# Исключаем файлы окружения, содержащие пароли и ключи
*.env
*.env.*
backend/.env
backend/.env.local

# Разрешаем коммитить только шаблоны настроек
!*.env.example
 